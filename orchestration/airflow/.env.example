AIRFLOW_DB_USER=airflow_user
AIRFLOW_DB_PASSWORD=replace-with-a-random-password
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow_user:replace-with-a-url-encoded-password@db:5432/airflow
AIRFLOW__CORE__FERNET_KEY=replace-with-a-generated-fernet-key
AIRFLOW__API_AUTH__JWT_SECRET=replace-with-a-random-jwt-secret
AIRFLOW__CORE__AUTH_MANAGER=airflow.providers.fab.auth_manager.fab_auth_manager.FabAuthManager
AIRFLOW__CORE__TEST_CONNECTION=Enabled
AIRFLOW__API__EXPOSE_CONFIG=true
_AIRFLOW_WWW_USER_CREATE=true
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=replace-with-a-random-admin-password

POP_TALK_POSTGRES_HOST=host.docker.internal
POP_TALK_POSTGRES_PORT=55432
POP_TALK_POSTGRES_DB=pop_talk_local
POP_TALK_POSTGRES_USER=pop_talk_local
POP_TALK_POSTGRES_PASSWORD=copy-from-application-local-config

# Platform control state is separate from the application service database.
POP_TALK_CONTROL_POSTGRES_HOST=db
POP_TALK_CONTROL_POSTGRES_PORT=5432
POP_TALK_CONTROL_POSTGRES_DB=pop_talk_platform
POP_TALK_CONTROL_POSTGRES_USER=dw_control_runtime
POP_TALK_CONTROL_POSTGRES_PASSWORD=replace-with-a-random-control-password

SNOWFLAKE_ACCOUNT=configure-account
SNOWFLAKE_USER=POP_TALK_DBT_USER
SNOWFLAKE_PRIVATE_KEY_PATH=/keys/pop_talk_dbt_key.p8
